# Pingly — reverse proxy for every domain the platform answers on.
#
# Versioned here and applied with `./deploy.sh caddy` (monorepo root), which
# validates it inside the caddy container, backs up the live file, copies this
# one over it in place and reloads. Do not edit /opt/pingly/Caddyfile on the
# server: the next `./deploy.sh caddy` overwrites it, and `sed -i` replaces the
# inode, so the container keeps reading the old file while reload says success.
#
# Two kinds of site:
#
#   chat.pingly.com.br — the platform host (PLATFORM_URL). Everything: the
#     dashboard and its API, the Back Office, and every address handed to a
#     system outside the platform — webhooks, OAuth callbacks, the widget API,
#     signed links, media.
#
#   Country domains (`import country_site`) — the dashboard and its API only.
#     Platform-only paths answer 404 before reaching PHP; Laravel's
#     EnsurePlatformHost answers the same 404 if one ever slips through. The
#     backend never hands those paths out on a country domain, so nothing
#     legitimate is lost. Adding a country: docs/country-domains.md.


# ── Snippets ─────────────────────────────────────────────────────────────────

# Laravel's front controller.
#
# Two PHP-FPM containers, load balanced, because a deploy replaces them one at
# a time: while one is being recreated the other keeps accepting FastCGI, so the
# outage shrinks from seconds to a single request (see the measured note below).
# Before this it named a single container, and
# recreating that container removed the name from Docker's DNS entirely --
# Caddy answered `lookup app: no such host` with a 502 for 2-14 seconds on
# every deploy. 336 inbound webhooks were rejected that way, and the senders
# that do not retry (the API Way core) lost those messages for good.
#
# fail_duration takes a container out of rotation after one failed dial, so the
# next request goes straight to its sibling instead of paying the same failure
# again. It counts transport failures only, never HTTP status, so a 500 from PHP
# never removes a container -- otherwise one application bug would empty the pool.
#
# ⚠️⚠️ WHAT DOES NOT WORK, so nobody spends another evening on it: Caddy cannot
# retry a non-GET request over the FastCGI transport. Not with lb_try_duration,
# not with lb_retry_match (any matcher, including one that matches everything),
# not with request_buffers. All three were measured in an isolated lab, one
# upstream stopped, 40 POSTs each: 3 of 40 still returned 502 and the slowest
# took 0.005s -- no retry was ever attempted. The documented rule ("a dial
# failure is always retried, regardless of method") holds for the HTTP transport,
# whose dial errors are wrapped in a `DialError`; the FastCGI transport dials
# inside its own RoundTrip and returns a plain error, so `tryAgain` falls through
# to the guard that only retries GET.
#
# The consequence is honest and small: when a container is recreated, the FIRST
# request that happens to pick it fails. `fail_duration` then parks it and every
# following request goes to its sibling, so that is roughly one failed POST per
# container replaced -- about two per deploy, against 2-14 whole seconds of them
# before. GET/HEAD/OPTIONS are covered, because those Caddy does retry.
#
# Closing that last gap belongs to the sender, not here: Meta and Telegram retry
# a 502 on their own, and for the API Way core (which does not) the fix is a
# retry on their side. See docs/zero-downtime-deploy.md.
#
# `app` keeps its name (rather than becoming app-a/app-b) so that every runbook
# and every one-off `docker compose exec app php artisan ...` still works.
(laravel) {
    root * /var/www/html/public
    php_fastcgi app:9000 app-2:9000 {
        # round_robin, NOT least_conn: on a retry Caddy picks an upstream again
        # through this policy, and a container that is down holds zero
        # connections -- so least_conn keeps choosing the dead one and the retry
        # never escapes. round_robin moves to the sibling on the next attempt.
        lb_policy round_robin

        # Short on purpose, both of them. fail_duration parks a container after
        # a failed dial so the next request skips it; lb_try_duration bounds how
        # long a request is held while Caddy looks for a live one.
        #
        # ⚠️ Keep these SMALL. `errNoUpstream` -- every upstream parked at once --
        # is retried with no method guard at all, so a long try_duration turns a
        # brief double-fault into every request hanging for that full duration.
        # Measured at 20s: requests were held 20.08s and then 503, which is far
        # worse than one fast 502. The window this has to cover is a container
        # restart, and a container is back in ~2s.
        fail_duration 3s
        lb_try_duration 5s
        lb_try_interval 150ms

        # Restores Caddy's default (retry safe methods). Defining any
        # lb_retry_match REPLACES the default rather than adding to it: without
        # this set, even a GET would stop being retried.
        lb_retry_match {
            method GET HEAD OPTIONS
        }
    }
}

# A built single-page app served from {args[0]}.
#
# Hashed assets are cached for a year ONLY when the file exists; index.html
# always revalidates so a deploy is picked up at once. A missing asset is a
# no-store 404, never index.html: HTML cached as "immutable" under a .js URL
# poisons that browser for a year ("Expected a JavaScript module… MIME type
# text/html"). Only non-asset routes fall back to index.html.
(spa) {
    root * {args[0]}

    @assets {
        path /assets/*
        file
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"

    @html not path /assets/*
    header @html Cache-Control "no-cache"

    @missing_asset {
        path /assets/*
        not file
    }
    header @missing_asset Cache-Control "no-store"

    @spa {
        not path /assets/*
        not file
    }
    rewrite @spa /index.html

    file_server
}

# Security headers, for every site.
#
# There were none at all — no CSP, no frame protection, no HSTS, no nosniff —
# on an origin that serves the tenant dashboard at `/`, the Back Office at
# `/webmin`, and customer-uploaded files at `/storage`, with session tokens in
# localStorage. That combination is what turned an unrestricted upload into a
# platform takeover rather than a defaced page.
#
# ⚠️ The CSP is REPORT-ONLY on purpose, and must stay that way until its
# reports have been watched for a while. Two things this app loads are chosen
# at runtime and cannot be read off the source: the card-tokenisation SDK, whose
# host depends on which gateway minted the session, and Meta's SDK, injected
# only when somebody opens the WhatsApp signup popup. Enforcing a policy that
# has never seen either would break checkout and channel onboarding — silently,
# for the customers unlucky enough to be the first to try.
#
# ⚠️ `microphone=(self)` is not decoration: the composer records voice notes.
# Dropping it to `()` would disable that with no error anyone can see.
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), camera=(), microphone=(self), payment=()"

        # Observed, not enforced. Promote to Content-Security-Policy once the
        # reports are quiet — see docs/security-headers.md.
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://sdk.mercadopago.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' wss://ws.pingly.com.br https://ewr1.vultrobjects.com https://sdk.mercadopago.com https://connect.facebook.net; frame-src https://connect.facebook.net https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

        # Nothing is served that needs to advertise what serves it.
        -Server
    }
}

# A country domain: the tenant dashboard and its API, nothing else.
(country_site) {
    encode gzip
    import security_headers

    # Platform-only, and kept that way: webhooks and OAuth callbacks are
    # registered on the platform host, signed links are signed for it, media is
    # linked to it, and the Back Office is operated from it. /oauth/result is
    # deliberately absent — it is a dashboard route.
    # /widget.js and /widget/* are here for the same reason as /widget-api:
    # the widget they install talks to the origin that served them, and that
    # API answers 404 on this domain. Handing out a widget that cannot reach
    # its backend is worse than not handing one out.
    @platform_only path /webmin /webmin/* /api/admin /api/admin/* /webhook /webhook/* /widget-api /widget-api/* /widget.js /widget/* /oauth/instagram/* /oauth/facebook/* /oauth/tiktok/* /instagram/deletion-status /broadcasting /broadcasting/* /storage /storage/* /gallery/* /flow-payments/* /flow-invoices/*
    handle @platform_only {
        header Cache-Control "no-store"
        respond 404
    }

    @backend path /api /api/* /up
    handle @backend {
        import laravel
    }

    handle {
        import spa /srv/web/client
    }
}


# ── Platform host ────────────────────────────────────────────────────────────

chat.pingly.com.br {
    encode gzip
    import security_headers

    # The embeddable chat widget, pasted into sites we do not own. Two files
    # with opposite caching, which is the whole reason they are two files:
    # /widget.js is the address written into other people's HTML and can never
    # change, so it is short-lived and revalidated; the bundle it names carries
    # a content hash and is therefore safe to keep forever. Publishing a new
    # widget then costs each visitor one small revalidation.
    #
    # Static files straight from the backend's public folder — no PHP, and no
    # SPA fallback: index.html answered under a .js URL and cached as
    # "immutable" would poison that browser for a year.
    @widget path /widget.js /widget/*
    handle @widget {
        root * /var/www/html/public
        header /widget.js Cache-Control "public, max-age=300"

        @widget_bundle {
            path /widget/*
            file
        }
        header @widget_bundle Cache-Control "public, max-age=31536000, immutable"

        # A bundle that is not there yet — the Caddyfile deployed ahead of the
        # backend, which is the recommended order — must not be remembered as
        # missing for a year. Same guard, same reason, as @missing_asset above.
        @widget_gone {
            path /widget/*
            not file
        }
        header @widget_gone Cache-Control "no-store"

        file_server
    }

    # Laravel routes outside the SPA. A path missing here falls through to the
    # SPA and answers index.html with a 200 — how every webhook once failed
    # silently, and how the TikTok OAuth callback did until Sep 2026. A new
    # top-level Laravel web route needs its prefix added here.
    @backend path /api /api/* /gallery/* /flow-payments/* /flow-invoices/* /webhook /webhook/* /widget-api /widget-api/* /oauth/instagram/* /oauth/facebook/* /oauth/tiktok/* /instagram/deletion-status /broadcasting /broadcasting/* /up
    handle @backend {
        import laravel
        file_server
    }

    # Signed private media (profile photos, message media) lives in
    # storage/app/private and is served by Laravel's "storage.local" route so
    # the signature is checked and the file streamed from the private disk.
    # Recognised by its ?signature= query.
    @signed_media {
        path /storage/*
        expression {http.request.uri.query.signature} != ""
    }
    handle @signed_media {
        import laravel
    }

    # Unsigned public files: uploads stored in flows and campaigns, Instagram
    # post media, copies Meta fetches while sending. Served from the local
    # public disk while the file is still there; otherwise from the bucket's
    # public prefix, where they live since media moved to object storage
    # (docs/media-object-storage.md). Addresses stored before the move keep
    # working either way.
    handle_path /storage* {
        root * /var/www/html/storage/app/public

        # ⚠️ Everything below this line is served WITHOUT a signature — the
        # signed half is the @signed_media matcher above, which sends anything
        # carrying ?signature= to Laravel. That split is deliberate (public
        # media has to be fetchable by Meta and Telegram, which carry no
        # credential) but it means the only thing between a path and the bytes
        # is knowing the path. Names here are random, which is why it holds —
        # and why nothing whose secrecy matters may be written to this disk.
        # Private media lives on MEDIA_DISK and is reached through the signed
        # route, never through here.
        #
        # The proxy at the bottom is scoped to one bucket prefix on purpose:
        # `/pingly-media/public{path}` and nothing else, so it cannot be walked
        # into the private prefix beside it.

        # These bytes were uploaded by customers and are served from the same
        # origin as the dashboard and /webmin, so they are served as data and
        # never as a document. Upload validation (App\Services\Media\
        # UploadPolicy) keeps HTML and SVG out in the first place; this is what
        # holds when the two disagree — a polyglot that is a valid GIF *and*
        # valid HTML passes validation as an image, and `nosniff` is what stops
        # the browser deciding it is the second thing.
        #
        # Both headers are inert for the fetchers that actually matter on this
        # path — Meta, Telegram and Discord pulling media to deliver it — since
        # a CSP on a subresource response is not applied to that subresource.
        header {
            X-Content-Type-Options "nosniff"
            Content-Security-Policy "default-src 'none'; sandbox"
        }

        @local_file file
        handle @local_file {
            file_server
        }

        handle {
            rewrite * /pingly-media/public{path}
            reverse_proxy https://ewr1.vultrobjects.com {
                header_up Host ewr1.vultrobjects.com
            }
        }
    }

    handle_path /webmin* {
        import spa /srv/web/admin
    }

    # A temporary preview of the marketing site (nuvemchat-lp), published here
    # because this host already has the certificate and the deploy path. Built
    # with LP_BASE=/temp/preview/, so every asset URL and every link the page
    # writes for itself already carries the prefix.
    #
    # ⚠️ `handle`, NOT `handle_path`: the prefix must not be stripped. The
    # preview is four real directories (/, /en/, /es/, /id/), and file_server
    # answers a missing trailing slash with a canonical redirect — computed
    # from the request path. With the prefix stripped that redirect points at
    # /en/ on this host, which is the dashboard, not the English page.
    #
    # ⚠️ noindex twice over. The header covers anything that never parses the
    # HTML; the pages carry <meta name="robots"> from the same build flag. This
    # is the live marketing copy at a second address, and one of the two has to
    # be invisible to search or they compete with each other.
    #
    # no-store because it is a preview: a redeploy has to be visible on the
    # next reload, and nobody is serving enough of it for caching to matter.
    handle /temp/preview* {
        root * /srv/web
        header {
            X-Robots-Tag  "noindex, nofollow"
            Cache-Control "no-store"
        }
        file_server
    }

    handle {
        import spa /srv/web/client
    }
}

ws.pingly.com.br {
    # ⚠️ There is no connection ceiling here, and stock Caddy cannot provide
    # one — a limiter means a plugin build.
    #
    # ⚠️⚠️ And REVERB_APP_MAX_CONNECTIONS does not cover this either, which is
    # easy to assume and wrong. Reverb checks it in Server::open(), against
    # `$channels->for($app)->connections()` — the connections registered in a
    # CHANNEL. A socket that connects and never sends `pusher:subscribe` is
    # counted by neither that check nor PruneStaleConnections, which walks the
    # same list: it is invisible to both and lives until the TCP connection
    # dies. The setting bounds clients that behave like clients; it does not
    # bound a silent socket flood.
    #
    # The real ceiling for raw sockets is the file-descriptor limit of the
    # reverb container (`ulimits` in docker-compose) and, if it is ever put
    # behind one, the edge. Worth caring about because the Reverb app key is
    # public by necessity — the widget is handed it by GET /widget-api/config,
    # since the widget's own channel is public. An unsubscribed socket reads
    # nothing; it just occupies a descriptor, and exhausting them takes
    # realtime away from every dashboard at once.
    reverse_proxy reverb:8080
}


# ── Country domains ──────────────────────────────────────────────────────────
#
# One block each. Before adding one here, its DNS must already point at this
# server (Caddy requests the certificate on reload). Then register the domain
# in market_domains and in the Meta app — see docs/country-domains.md.

# Indonesia — running in parallel with the platform host while the market is
# being prepared.
chat.pingly.id {
    import country_site
}

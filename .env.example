APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Address given to webhooks, OAuth callbacks and signed links, whichever country
# domain a request arrived on. Scheme + host only. Empty = follow the request.
PLATFORM_URL=

# Where media lives (config/media.php, App\Services\Media\MediaStorage).
# Private media / copies channels fetch while sending / URLs stored for months.
MEDIA_DISK=local
MEDIA_OUTBOUND_DISK=public
MEDIA_PUBLISHED_DISK=public
# While moving media: files not yet on the new disk are still served from this one.
MEDIA_LEGACY_DISK=

# Object storage for media (disks "media" and "media_public", one bucket split by
# prefix). Point the MEDIA_*_DISK settings at them to use it — see
# docs/media-object-storage.md.
MEDIA_S3_KEY=
MEDIA_S3_SECRET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=pingly-media
MEDIA_S3_ENDPOINT=https://ewr1.vultrobjects.com
MEDIA_S3_PUBLIC_URL=https://ewr1.vultrobjects.com/pingly-media

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# How long an AI agent node waits after the customer's last message before it
# answers, so a question typed across several messages gets one reply instead of
# one per message. 0 answers on arrival. See docs/ai-turn-delay.md.
AI_TURN_DELAY_SECONDS=8

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
